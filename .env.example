# ── App ──────────────────────────────────────────────────────────────
APP_NAME=Product Gallery
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/product_gallery
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (CHANGE IN PRODUCTION!) ──────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production-use-openssl-rand-hex-32

# ── S3 / MinIO ───────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=product-gallery

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
